# ── API Keys ──
ZHIPUAI_API_KEY=your_key_here
ELEVEN_LABS_KEY=your_key_here

# ── Publishing: YouTube ──
YOUTUBE_CLIENT_SECRETS_FILE=credentials/youtube_client_secrets.json
YOUTUBE_CREDENTIALS_FILE=credentials/youtube_token.json
# Upload privacy: private | unlisted | public. Keep "private" for the first
# verification upload, then switch to public.
YOUTUBE_PRIVACY=public

# ── Publishing: TikTok ──
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
# Refresh token (TikTok access tokens expire in ~24h). Obtain once via:
#   python tools/tiktok_auth.py --authorize
# Tokens are then cached in credentials/tiktok_token.json and refreshed
# automatically before each publish.
TIKTOK_REFRESH_TOKEN=
TIKTOK_REDIRECT_URI=
TIKTOK_TOKEN_FILE=credentials/tiktok_token.json

# ── Publishing: Instagram ──
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ── n8n Automation ──
N8N_KEY=your_n8n_api_key_here
N8N_PASSWORD=changeme
TZ=Europe/London

# ── Telegram Delivery ──
# 1. Create bot via @BotFather → get token
# 2. Send /start to bot → run: python -m tools.telegram_sender --get-chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Wake-on-LAN (optional: only for waking a remote PC from this machine) ──
# Leave empty when this Mac runs the pipeline itself; pmset handles the wake.
WOL_MAC=
WOL_BROADCAST=255.255.255.255
WOL_PORT=9

# ── Daily automation (macOS launchd + pmset) ──
# Installed with:
#   python src/automate.py --install-schedule   # launchd agent at RUN_TIME
#   python src/automate.py --install-wake       # sudo pmset wake at WAKE_TIME
RUN_TIME=06:00
WAKE_TIME=05:50:00
# Hard ceiling for one pipeline run, in seconds. Keep this above the full
# eight-image run plus retries.
PIPELINE_TIMEOUT=14400

# ── PostgreSQL Database (Phase 1) ──
# For Docker: POSTGRES_HOST=postgres (the service name)
# For local dev: POSTGRES_HOST=localhost
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=yt_machine
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_DB=yt_machine

# ── Pipeline Version Toggle (Phase 7 safety mechanism) ──
# "v1" = old reliable pipeline (generate_complete_video.py)
# "v2" = modern stack pipeline (generate_v2.py — async, LangChain, pgvector)
# Change this ONE line to instantly rollback if anything goes wrong.
PIPELINE_VERSION=v1

# ── Structured Logging (Phase 8) ──
# LOG_FORMAT: "console" (colored, human-readable) or "json" (machine-parseable for Elasticsearch/Loki)
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR
# Logs are written to both console AND output/logs/pipeline_YYYYMMDD.log
LOG_FORMAT=console
LOG_LEVEL=INFO

# ── Image Generation: Qwen-Image-2512 via MLX-Gen ──
YT_GENERATION_PROFILE=qwen_pixel_scene
MLXGEN_BIN=/Users/rafa9-labs/AI/FluxSprites/.venv/bin/mlxgen
MLXGEN_TIMEOUT=900
# Full production count is 8. Set to 4 for a real one-story smoke run.
YT_IMAGE_LIMIT=8
