# ── API Keys ──
ZHIPUAI_API_KEY=your_key_here
FAL_KEY=your_key_here
ELEVEN_LABS_KEY=your_key_here

# ── Publishing: YouTube ──
YOUTUBE_CLIENT_SECRETS_FILE=credentials/youtube_client_secrets.json
YOUTUBE_CREDENTIALS_FILE=credentials/youtube_token.json

# ── Publishing: TikTok ──
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ── Publishing: Instagram ──
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ── n8n Automation ──
N8N_KEY=your_n8n_api_key_here
N8N_PASSWORD=changeme
TZ=Europe/London

# ── Telegram Delivery ──
# 1. Create bot via @BotFather → get token
# 2. Send /start to bot → run: python -m tools.telegram_sender --get-chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Wake-on-LAN (target PC) ──
# MAC address of the PC to wake. Find via: ipconfig /all → Physical Address
WOL_MAC=
WOL_BROADCAST=255.255.255.255
WOL_PORT=9

# ── PostgreSQL Database (Phase 1) ──
# For Docker: POSTGRES_HOST=postgres (the service name)
# For local dev: POSTGRES_HOST=localhost
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=yt_machine
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_DB=yt_machine

# ── Pipeline Version Toggle (Phase 7 safety mechanism) ──
# "v1" = old reliable pipeline (generate_complete_video.py)
# "v2" = modern stack pipeline (generate_v2.py — async, LangChain, pgvector)
# Change this ONE line to instantly rollback if anything goes wrong.
PIPELINE_VERSION=v1

# ── Structured Logging (Phase 8) ──
# LOG_FORMAT: "console" (colored, human-readable) or "json" (machine-parseable for Elasticsearch/Loki)
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR
# Logs are written to both console AND output/logs/pipeline_YYYYMMDD.log
LOG_FORMAT=console
LOG_LEVEL=INFO

# ── Image Generation Target App (PinguPlay / PinguQuest / PinguHero / Default) ──
# Controls output resolution via Together AI FLUX.1-schnell
TARGET_APP=Default

# ── FLUX Local Quantization ──
# "8bit" = ~14-16GB VRAM, near-lossless quality (recommended for 24GB GPUs)
# "4bit" = ~6-7GB VRAM, slight quality loss
# "none" = full bf16, ~24GB VRAM
LOCAL_FLUX_QUANTIZE=8bit

# ── FLUX Compute Optimization ──
# "none" = no compilation, pipeline destroyed after each image (default)
# "reduce-overhead" = torch.compile(transformer), pipeline kept alive between calls
# "max-autotune" = torch.compile(transformer), best speed but slower warmup, pipeline kept alive
# When enabled, pipeline stays in VRAM — call _flush_flux_pipeline() to release it
LOCAL_FLUX_COMPILE=none

# ── FLUX VRAM Guardrails ──
# Minimum free VRAM (GB) required to load FLUX locally. Falls back to fal.ai if below threshold.
LOCAL_FLUX_MIN_VRAM_GB=14
# When true, evicts Ollama models from GPU before loading FLUX to free VRAM.
LOCAL_FLUX_EVICT_OLLAMA=true
