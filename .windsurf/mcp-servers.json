{
  "mcp_servers": {
    "llm_interface": {
      "name": "LLM Interface (Ollama)",
      "module": "brain/llm_interface.py",
      "class": "LLMInterface",
      "critical": true,
      "functions": [
        "generate",
        "chat",
        "process_news",
        "debate_skeptic",
        "debate_explainer",
        "synthesize_script",
        "check_connection",
        "warmup_model"
      ],
      "config": "config/system_prompts.json",
      "health_check": "check_connection",
      "description": "Local LLM interface via Ollama for content generation and debate synthesis"
    },
    "rss_scraper": {
      "name": "RSS Feed Scraper",
      "module": "redfish/rss_scraper.py",
      "class": "RSScraper",
      "critical": true,
      "functions": [
        "scrape_all",
        "filter_viral_potential",
        "fetch_feed",
        "get_article_text"
      ],
      "config": "config/rss_feeds.json",
      "description": "Fetches and filters geopolitical news from RSS feeds"
    },
    "debate_engine": {
      "name": "Debate Engine",
      "module": "redfish/debate_engine.py",
      "class": "DebateEngine",
      "critical": true,
      "functions": [
        "run_full_pipeline",
        "process_top_articles",
        "save_results"
      ],
      "dependencies": ["llm_interface", "rss_scraper", "memory_reader"],
      "description": "Orchestrates news analysis, debate, and script synthesis"
    },
    "memory_logger": {
      "name": "Memory Logger",
      "module": "open-viking/memory_logger.py",
      "class": "MemoryLogger",
      "critical": true,
      "functions": [
        "log_video",
        "update_performance",
        "get_all_videos"
      ],
      "storage": "open-viking/history/videos.json",
      "description": "Logs generated videos and performance metrics to persistent memory"
    },
    "memory_reader": {
      "name": "Memory Reader",
      "module": "open-viking/memory_reader.py",
      "class": "MemoryReader",
      "critical": true,
      "functions": [
        "get_recent_videos",
        "check_topic_coverage",
        "get_performance_stats",
        "search_by_keyword"
      ],
      "storage": "open-viking/history/videos.json",
      "description": "Reads and queries video history for duplicate detection and analytics"
    },
    "viking_bridge": {
      "name": "Viking Bridge API",
      "module": "viking_bridge.py",
      "type": "fastapi",
      "critical": false,
      "endpoints": [
        "GET /",
        "GET /health",
        "GET /status",
        "POST /trigger-video"
      ],
      "port": 5000,
      "description": "FastAPI server orchestrating the full video generation pipeline"
    },
    "pexels_tool": {
      "name": "Pexels Footage Fetcher",
      "module": "video_server/pexels_tool.py",
      "type": "fastmcp",
      "critical": true,
      "tools": [
        "fetch_vertical_footage"
      ],
      "config": ".env",
      "env_var": "PEXELS_API_KEY",
      "output_dir": "output/footage",
      "description": "Fetches vertical (9:16) HD video clips from Pexels API for video assembly"
    },
    "tts_tool": {
      "name": "TTS Voiceover Generator",
      "module": "video_server/tts_tool.py",
      "type": "fastmcp",
      "critical": true,
      "tools": [
        "generate_voiceover"
      ],
      "output_dir": "output/audio",
      "voice_options": [
        "authoritative",
        "professional",
        "energetic",
        "calm",
        "deep",
        "female_professional",
        "female_energetic",
        "male_casual"
      ],
      "description": "Generates high-fidelity voiceovers using Edge TTS with multiple voice styles"
    },
    "assembler_tool": {
      "name": "Video Assembler",
      "module": "video_server/assembler_tool.py",
      "type": "fastmcp",
      "critical": true,
      "tools": [
        "build_final_video"
      ],
      "output_dir": "output/videos",
      "effects": [
        "ken_burns_zoom",
        "crt_scanlines"
      ],
      "description": "Assembles final videos from audio and assets using MoviePy with optional pixel-art effects"
    },
    "pixel_art_tool": {
      "name": "Pixel Art Generator",
      "module": "video_server/pixel_art_tool.py",
      "type": "fastmcp",
      "critical": false,
      "tools": [
        "generate_pixel_art"
      ],
      "env_var": "OPENAI_API_KEY",
      "output_dir": "output/images",
      "style_suffix": "16-bit pixel art, cinematic lighting, cyberpunk aesthetic, high contrast",
      "model": "dall-e-3",
      "fallback": "pillow_placeholder",
      "description": "Generates 16-bit cyberpunk pixel art scenes via DALL-E 3, falls back to Pillow placeholder if no API key"
    }
  },
  "startup_sequence": [
    "llm_interface",
    "rss_scraper",
    "memory_logger",
    "memory_reader",
    "debate_engine",
    "pexels_tool",
    "tts_tool",
    "pixel_art_tool",
    "assembler_tool",
    "viking_bridge"
  ],
  "health_checks": {
    "interval_seconds": 30,
    "timeout_seconds": 5,
    "retry_attempts": 3
  }
}
