# yt-machine environment template
# ================================
# Copy to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit real keys.
# Everything below is optional unless marked REQUIRED. Blank means "feature
# disabled" — the pipeline degrades rather than failing on most of these.

# ─────────────────────────────────────────────────────────────────────────
# LLM backend (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────
# The pipeline runs its text models locally. Point this at your local server.
# Ollama default is http://localhost:11434; llama.cpp is usually :8080.
OLLAMA_HOST=http://localhost:11434

# Model used for analysis, script synthesis and curation.
OLLAMA_MODEL=qwen3:14b
# Optional separate model for image review. Leave blank to disable vision QA.
OLLAMA_VISION_MODEL=

# Embedding model for cross-run topic memory. Requires Postgres + pgvector.
EMBEDDING_MODEL=nomic-embed-text

# llama.cpp server (only if you run the OpenAI-compatible backend instead)
LLAMACPP_ENDPOINT=http://127.0.0.1:8080
LLAMACPP_PORT=8080
LLAMACPP_CTX=32768
LLAMACPP_PARALLEL=1
LLAMACPP_REASONING=0
LLAMACPP_START_TIMEOUT=180

# ─────────────────────────────────────────────────────────────────────────
# Image generation
# ─────────────────────────────────────────────────────────────────────────
# Local image generation goes through MLX-Gen on Apple Silicon.
# Path to the mlxgen executable:
MLXGEN_BIN=/usr/local/bin/mlxgen
MLXGEN_TIMEOUT=900
MLXGEN_STEPS=8
MLXGEN_GUIDANCE=3.5

# Which generation profile to use (see config/generation_profiles.json).
# Image provenance sidecars are controlled per profile with `provenance`
# (boolean, default true) — they are written next to each image and copied
# into the project folder, so they are not an env setting.
YT_GENERATION_PROFILE=qwen_pixel_scene

# Where your downloaded image/text models live (colon-separated).
YT_MODEL_ROOTS=
# Where pixel-art LoRA adapters live (colon-separated).
YT_LORA_ROOTS=

# Image count per run. Production is 8 (2 stories x 4 beats).
# Set to 4 for a cheap one-story smoke test.
YT_IMAGE_LIMIT=8

# Skip image generation entirely and use placeholders (1 = skip).
# Useful for testing script/TTS/assembly without a GPU.
SKIP_IMAGES=0

# Optional path to a different generation-profiles JSON file.
YT_GENERATION_PROFILES_PATH=

# Optional override of which model role profile is used
# (see config/model_profile.json).
YT_MODEL_PROFILE=

# Which GPU(s) the legacy CUDA/FLUX path may see, e.g. "0" or "0,1".
CUDA_VISIBLE_DEVICES=

# Legacy local FLUX path (CUDA). "auto" = use it when a GPU is available.
USE_LOCAL_FLUX=auto
LOCAL_FLUX_MODEL=
LOCAL_FLUX_QUANTIZE=
LOCAL_FLUX_STEPS=40
LOCAL_FLUX_MIN_VRAM_GB=12
LOCAL_FLUX_COMPILE=0
LOCAL_FLUX_EVICT_OLLAMA=1

# fal.ai API key — ONLY needed for the optional cloud image fallback.
# Get one at https://fal.ai/dashboard/keys. Leave blank to stay local-only.
FAL_KEY=

# Pexels — optional stock footage fallback.
# https://www.pexels.com/api/
PEXELS_API_KEY=

# HuggingFace token — only needed to download gated models/LoRAs.
HF_TOKEN=

# ─────────────────────────────────────────────────────────────────────────
# Text-to-speech
# ─────────────────────────────────────────────────────────────────────────
# Kokoro is the local primary engine; "auto" enables it when installed.
USE_KOKORO=auto

# ElevenLabs — optional cloud TTS fallback. https://elevenlabs.io/
# ELEVEN_LABS_KEY is what the TTS engine reads; ELEVENLABS_API_KEY is the
# alias used by the config loader. Set both to the same value.
ELEVEN_LABS_KEY=
ELEVENLABS_API_KEY=
# Voice ID; the default is a stock ElevenLabs voice.
ELEVENLABS_VOICE_ID=G2BYBzpEHIacF1Bva0XL

# ─────────────────────────────────────────────────────────────────────────
# Publishing — YouTube
# ─────────────────────────────────────────────────────────────────────────
# OAuth files produced by `python tools/youtube_auth.py`.
YOUTUBE_CLIENT_SECRETS_FILE=credentials/youtube_client_secrets.json
YOUTUBE_CREDENTIALS_FILE=credentials/youtube_token.json
# private | unlisted | public — keep "private" for your first test upload.
YOUTUBE_PRIVACY=private

# ─────────────────────────────────────────────────────────────────────────
# Publishing — TikTok (optional)
# ─────────────────────────────────────────────────────────────────────────
# Obtain tokens with: python tools/tiktok_auth.py --authorize
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_REDIRECT_URI=
TIKTOK_TOKEN_FILE=credentials/tiktok_token.json

# ─────────────────────────────────────────────────────────────────────────
# Publishing — Instagram (optional)
# ─────────────────────────────────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ─────────────────────────────────────────────────────────────────────────
# Telegram delivery (optional)
# ─────────────────────────────────────────────────────────────────────────
# Create a bot with @BotFather, then run:
#   python -m tools.telegram_sender --get-chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────────────────────────────────
# Database (optional)
# ─────────────────────────────────────────────────────────────────────────
# Postgres is optional — JSON on disk is authoritative. Needed only for
# cross-run vector memory. `infra/docker-compose.yml` provides one.
DATABASE_URL=postgresql://yt_machine:changeme@localhost:5432/yt_machine
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=yt_machine
POSTGRES_PASSWORD=changeme
POSTGRES_DB=yt_machine

# ─────────────────────────────────────────────────────────────────────────
# Automation — daily run (macOS launchd)
# ─────────────────────────────────────────────────────────────────────────
#   python src/automate.py --install-schedule
#   python src/automate.py --install-wake
RUN_TIME=06:00
WAKE_TIME=05:50:00
# Hard ceiling for one run, in seconds. Keep above the full 8-image run.
PIPELINE_TIMEOUT=14400
# How long an idle machine waits before sleeping again, in minutes.
IDLE_SLEEP_MIN=20

# Wake-on-LAN: only when this machine must wake a *separate* PC.
# Leave blank when the Mac runs the pipeline itself (pmset handles the wake).
WOL_MAC=
WOL_BROADCAST=255.255.255.255
WOL_PORT=9
WOL_PING_HOST=localhost
WOL_PING_PORT=11434
WOL_WAIT_SECONDS=120

# Pipeline lock: prevents two concurrent runs from fighting over the GPU.
YT_PIPELINE_LOCK=/tmp/yt-machine-pipeline.lock
YT_PIPELINE_LOCK_STALE_S=21600

# ─────────────────────────────────────────────────────────────────────────
# Logging & output
# ─────────────────────────────────────────────────────────────────────────
# console | json
LOG_FORMAT=console
LOG_LEVEL=INFO
DEBUG=false
OUTPUT_DIRECTORY=./output
# Timezone for scheduled runs and the n8n container.
TZ=Europe/London

# ─────────────────────────────────────────────────────────────────────────
# Legacy / advanced — leave as-is unless you know you need them
# ─────────────────────────────────────────────────────────────────────────
# n8n automation server (optional; see infra/docker-compose.yml)
N8N_KEY=
N8N_PASSWORD=changeme

# Per-stage LLM timeouts, in seconds.
LLM_TIMEOUT_ANALYSIS=300
LLM_TIMEOUT_SYNTHESIS=600
LLM_TIMEOUT_CURATION=600
LLM_TIMEOUT_EVALUATION=300
LLM_TIMEOUT_FIXER=600
LLM_TIMEOUT_VISUALS=600

# OpenAI-compatible endpoint credentials, if you route text through one.
OPENAI_API_KEY=

# ZhipuAI (GLM) vision API — optional fallback for tools/image_curator.py
# when no local Ollama vision model is configured. https://open.bigmodel.cn/
ZHIPUAI_API_KEY=

# Target app sizing preset used by the fal.ai cloud path:
# PinguPlay | PinguQuest | PinguHero | Default (see config/image_style.json).
TARGET_APP=Default

# MLX bridge (used by tools/ollama_mlx_bridge.py on Apple Silicon).
MLX_MODEL=mlx-community/Qwen3.8-27B-OptiQ-4bit
MLX_BASE_URL=http://127.0.0.1:8080
MLX_BACKEND_TIMEOUT=600
BRIDGE_PORT=11434

# launchd agent label. Change only if you run multiple installs.
LAUNCHD_LABEL=com.rafa9labs.ytmachine
